# SecureIT Desktop API — environment template
# Copy this file to `.env` and fill in the values. All keys can also be
# provided as environment variables; they take precedence over `.env`.

# === REQUIRED ===
# Postgres connection string (ignored when EMBEDDED_DB is enabled).
# Used by the web/API inside Docker (docker-compose), where the host `db`
# only resolves inside the compose network. On the host machine `db` does
# not resolve, so prefer EMBEDDED_DB=true below.
DATABASE_URL=postgres://secureit:secureit@localhost:5432/secureit
# Base URL of the SecureIT web server (license activation / heartbeat).
WEB_URL=https://secureit-web.ag-fran-dev.workers.dev/
# Ed25519 public key (PEM) used to verify license tokens signed by the web
# server. Must match the web server's private key. It is public, but it is
# read from the env so it stays in sync with the web's key.
ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# === Optional ===
# Server / run mode.
DEBUG=false
PORT=8000
# Use the bundled PostgreSQL (pgserver, includes pgvector) instead of
# connecting to DATABASE_URL. The desktop launcher sets this automatically.
EMBEDDED_DB=false

# Media / uploads.
UPLOAD_MAX_SIZE=3145728
TIME_ZONE=Africa/Luanda

# === CI builds ===
# The release workflow reads the WHOLE env content from the GitHub secret
# `API_ENV_FILE` and writes it to `desktop/api/.env`, which is then bundled
# into the desktop API so FastAPI can read it at runtime.
