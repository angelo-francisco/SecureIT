# ─────────────────────────────────────────────────────────────
# SecureIT — Desktop (Tauri + Vite) — Variáveis de ambiente
# Cópia para .env e ajusta consoante o ambiente.
# ─────────────────────────────────────────────────────────────

# URL do backend FastAPI (apenas fora do shell Tauri / dev).
# Dentro do Tauri a URL é resolvida pela command `get_api_url`.
VITE_API_URL=http://localhost:8000

# URL do frontend web (Next.js) — usada para:
#   - login/auth com cookies (código por email, TOTP, Google)
#   - abrir "Criar Conta" no browser externo
VITE_WEB_URL=http://localhost:3000
