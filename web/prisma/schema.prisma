generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
  runtime    = "cloudflare"
  previewFeatures = ["driverAdapters"]
}

generator client_node {
  provider   = "prisma-client"
  output     = "../src/generated/prisma-node"
  engineType = "library"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL_SQLITE")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  pinHash      String?
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  license              License?
  profiles             SubProfile[]
  paymentRequests      PaymentRequest[]
  maintenanceRequests  MaintenanceRequest[]
}

model LicenseKey {
  id           String   @id @default(cuid())
  key          String   @unique
  type         String
  durationDays Int
  maxCameras   Int      @default(-1)
  maxPeople    Int      @default(-1)
  status       String   @default("PENDING")
  batchName    String?
  createdAt    DateTime @default(now())

  license License?

  @@index([key])
}

model License {
  id               String    @id @default(cuid())
  keyId            String    @unique
  userId           String    @unique
  paymentRequestId String?   @unique
  activatedAt      DateTime
  expiresAt        DateTime
  lastChecked      DateTime?
  hardwareFp       String?
  signedPayload    String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())

  key            LicenseKey      @relation(fields: [keyId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id])

  @@index([userId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model EmailCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  description  String?
  basePrice    Float
  currency     String   @default("USD")
  durationDays Int
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentRequests PaymentRequest[]
  features        PlanFeature[]
  services        PlanService[]
}

model PaymentInfo {
  id          String   @id @default(cuid())
  iban        String
  accountName String
  bankName    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  paymentRequests PaymentRequest[]
}

model PaymentRequest {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  paymentInfoId   String
  proofPublicId   String
  proofUrl        String
  status          String   @default("PENDING")
  adminNote       String?
  selectedFeatures String?
  selectedServices String?
  totalPrice      Float?
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?

  user        User         @relation(fields: [userId], references: [id])
  plan        Plan         @relation(fields: [planId], references: [id])
  paymentInfo PaymentInfo  @relation(fields: [paymentInfoId], references: [id])
  license     License?

  @@index([userId])
}

model SubProfile {
  id          String   @id @default(cuid())
  userId      String
  name        String
  avatarColor String   @default("#2C9ED5")
  pinHash     String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PlanFeature {
  id          String   @id @default(uuid())
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([planId, name])
}

model PlanService {
  id          String   @id @default(uuid())
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([planId, name])
}

model MaintenanceRequest {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  description    String
  status         String   @default("PENDING")
  proofPublicId  String?
  proofUrl       String?
  adminNote      String?
  hasPaidLicense Boolean  @default(false)
  totalPrice     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
