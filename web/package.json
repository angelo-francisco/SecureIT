{
  "name": "secureit-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "format": "bunx @biomejs/biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:d1:local": "wrangler d1 migrations apply secureit --local",
    "db:d1:remote": "wrangler d1 migrations apply secureit --remote",
    "db:d1:shell:local": "wrangler d1 execute secureit --local --command 'SELECT 1'",
    "db:d1:shell:remote": "wrangler d1 execute secureit --remote --command 'SELECT 1'"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.0.0",
    "lucide-react": "^0.501.0",
    "nanoid": "^5.0.0",
    "next": "^16.2.10",
    "next-cloudinary": "^6.17.5",
    "otpauth": "^9.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-phone-number": "^1.3.1",
    "react-phone-number-input": "^3.4.17",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}