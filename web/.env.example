# ─────────────────────────────────────────────────────────────
# SecureIT — Web (Next.js) — Variáveis de ambiente
# Cópia para .env.local e preenche com os teus valores.
# ─────────────────────────────────────────────────────────────

# ── Base de dados (obrigatório) ───────────────────────────────
# Turso (SQLite) URL e token de autenticação.
TURSO_DATABASE_URL=turso://...
TURSO_AUTH_TOKEN=...

# ── JWT (obrigatório) ─────────────────────────────────────────
# Segredo usado para assinar tokens de acesso, refresh e desafios 2FA.
JWT_SECRET=uma-string-longa-e-aleatoria
# Opcional: segredo separado para refresh tokens (se omisso usa JWT_SECRET).
JWT_REFRESH_SECRET=

# ── Chaves de assinatura ED25519 (obrigatório) ────────────────
# Usadas para assinar payloads de licenças (desktop verifica com a pública).
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."

# ── Google OAuth 2.0 (login com Google) ───────────────────────
# Criar credenciais em https://console.cloud.google.com/apis/credentials
# Redirect URI autorizado: <ORIGEM>/api/auth/callback/google
# (fluxo gerido pelo NextAuth em /api/auth/[...nextauth])
# Se não forem definidas, o botão Google fica desactivado na UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Segredo do NextAuth (se omisso usa JWT_SECRET).
NEXTAUTH_SECRET=

# ── Envio de e-mails via Gmail SMTP (App Password) ────────────
# Passos: ativa a verificação em 2 passos na conta Gmail, depois gera uma
# "Palavra-passe de app" em https://myaccount.google.com/apppasswords
# GMAIL_USER é o endereço da conta e GMAIL_APP_PASSWORD os 16 caracteres.
# Se não forem definidas, os códigos são apenas registados no log (dev).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=SecureIT

# ── Cloudinary (uploads de provas de pagamento) ───────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Turnstile (proteção de formulários) ───────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Criptografia de dados de pagamento (opcional) ─────────────
# Se omisso usa o fallback do código. Definir em produção.
PAYMENT_ENCRYPTION_KEY=

# ── Diversos ──────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
CI=false
